[Unit]
Description=herdr-tg watchdog — buzz the operator when the hub stops answering
Documentation=https://github.com/vinceferro/herdr-tg
# Deliberately NO After=/Requires= on herdr-tg.service. An alarm ordered after the thing it
# watches is an alarm that can be taken down with it.
# The failure route must not be the channel that is failing, so it is a desktop notification.
OnFailure=herdr-tg-watchdog-failed.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/herdr-tg-watchdog

# A --user manager does NOT inherit the login shell's environment. XDG_STATE_HOME and
# XDG_CONFIG_HOME are set in the operator's shell and absent here, so the script's `${XDG_…:-…}`
# fallbacks would silently resolve to different paths than the ones he tested by hand — the
# watchdog would then watch a file nobody writes and exit 0 forever. Name them.
Environment=HERDR_TG_STATE_DIR=%h/.local/state/herdr-tg
Environment=HERDR_TG_ENV_FILE=%h/.config/herdr-tg/env
# The default user PATH puts ~/.local/bin and mise's shims ahead of /usr/bin, and this unit holds
# a bot token. A shim named `curl` earlier in that PATH would be handed the credential.
Environment=PATH=/usr/bin:/bin

NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_INET/AF_INET6 for the Bot API. AF_UNIX and AF_NETLINK because glibc's resolver uses them to
# reach a local stub resolver and to enumerate interfaces; measured working without them on this
# box, but a resolver change would break the alarm silently, which is the failure this file exists
# to prevent. Listing them costs nothing.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
