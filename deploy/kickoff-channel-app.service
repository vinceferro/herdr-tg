[Unit]
# NOT named `kickoff-hub` — that name is TAKEN on this box by another organisation's live service
# (an NDJSON wire core of theirs, enabled and running for over a day). This unit carried that name
# for about an hour on 19 September, which put two destructive things in reach at once: a runbook
# `install` line that would have overwritten their unit file, and a `Conflicts=` on our phone-plane
# unit that would have had systemd STOP their running hub. A user manager's unit names are one
# namespace shared by every organisation on the box, which is why every unit this repo ships is
# prefixed `kickoff-channel` — a prefix checked free on this box before it was taken.
Description=Kickoff Channel (app plane) — the hub the app reads, with no messaging service and no credential
Documentation=https://github.com/vinceferro/herdr-tg/blob/main/docs/RUNNING-THE-HUB.md
After=default.target
# Never give up restarting. The same reasoning as kickoff-channel.service and kickoff-door.service:
# the operator reads a phone, and a start-limit burst would leave the agents' only door dead until he
# reaches a keyboard.
StartLimitIntervalSec=0
# One plane at a time, and it is a hard fact rather than a preference. Both hubs bind the same
# Unix socket and take the same single-hub lock, so the second to start is refused in milliseconds
# and leaves a failed unit behind. Naming it here makes systemd stop the other one instead, which
# is also what keeps "which plane is this box on" a question with one answer.
Conflicts=kickoff-channel.service

[Service]
Type=simple
# No wait for a name to resolve, unlike the phone hub. That unit waits up to thirty seconds for
# api.telegram.org because its first call is over the internet and a boot that beat the network up
# looked like a failure nobody caused. This hub calls nothing off this box, so there is nothing to
# wait for and the wait would only delay the door every agent here is blocked on.
#
# The plane is named in the command, so `systemctl --user cat` answers "which way does this box
# reach him" without anybody opening an environment file. It is a required argument with no
# default: a hub that worked it out from whether a token happened to be set would flip planes the
# day a credential file failed to render.
ExecStart=%h/.local/bin/kickoff-channel serve --to app

# There is NO EnvironmentFile= here, and its absence is the point. The phone hub names
# ~/.config/herdr-tg/env because that is where its bot token lives; this plane holds no credential
# at all, and a unit that read the credential file "just in case" would put a live token into the
# environment of a process whose whole promise is that it has none. If one is in the environment
# anyway — an old export, a copied unit — the binary says so in one line and goes on without it.
Environment=RUST_LOG=info

# Not only so the hub comes back. A hub that dies on the way up writes down which half was down
# and exits, and an alarm quotes that note only while it is under ninety seconds old. Nothing
# inside the binary can keep it young; this restart is what does.
Restart=always
RestartSec=5

# WHAT THIS UNIT'S HEALTH DOES NOT COVER. Every leg of this hub's heartbeat is this process
# watching itself: it writes the ring, it accepts at the agents' door, it lists the place his
# answers land. The whole of the distance between the operator and those three files is
# kickoff-door.service — a different unit, binary, port and credential — and this hub cannot
# witness it without becoming a thing that dials a port, which is the one thing it is built never
# to be. A box running this unit with no door at all stamps a green heartbeat for ever while the
# app is dark; it was tried. deploy/herdr-tg-watchdog.sh is what asks about that unit, and nothing
# in this file should be read as covering it.

# ── Hardening ───────────────────────────────────────────────────────────────────────────────────
# The same sandbox the phone hub runs in, directive for directive. It used to say it was tighter,
# because this hub dials nothing off the box and that one must reach api.telegram.org; the two
# lines that were meant to carry the difference turned out not to run here at all, and the note
# beside them says so. Both hubs listen on a local Unix socket that is not a port, write under the
# state home, and start no process.
#
# Every line below was run rather than taken on trust: one probe under `systemd-run --user`, twice
# — once bare, once under this unit's own directive list read out of this file — and a line counts
# as doing something only where the two runs disagreed.
# `tests/a_unit_promises_only_what_the_manager_running_it_enforces.rs` carries what each one said,
# and turns the workspace red the day somebody adds a directive nobody has run.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Three families: a Unix socket for the agents, and IPv4/IPv6 for the one thing on this plane that
# dials at all — the optional one-line gist, which `summarize.rs` proves is on this machine before
# a character of an agent's text is on the wire. Measured under `systemd-run --user`: a netlink
# socket opens bare and is refused under this list, so the refusal is real.
#
# A family list is not a destination list, and it must not be read as one. Nothing in this unit
# says where an IPv4 socket may go; the next note says what was measured of the pair that was
# supposed to.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The next two lines do nothing on this box, and the comment that stood here said the opposite —
# that they were what turned "nothing off the box, ever" from an intention into a fact. They are
# not. Filtering by address is a cgroup BPF program, an unprivileged user manager cannot install
# one, and every install this repo documents is `systemctl --user`.
#
# Measured on 19 September 2026 rather than reasoned about. A curl to 1.1.1.1 under
# `systemd-run --user` with both lines set answered 301; the control run, with no properties at
# all, answered 301. Nothing warns: the unit starts clean, `systemctl show` reads the addresses
# back as though they were in force, and the whole of the evidence is one journal line that no
# unit fails on — "bpf-firewall: Preparation of BPF allow maps failed: Operation not permitted".
# A reader of the unit, of `show` and of `status` is told the same untrue thing in all three
# places, which is why this is written at the line and not in a commit message.
#
# Kept rather than deleted, for two reasons. They are real the moment this unit is started by a
# system manager, or by a user manager with the BPF controller delegated to it — a change in how
# it is installed, not a change to this file. And a measurement is worth more beside the lines it
# is about than anywhere else.
#
# What keeps an agent's words on this machine is the binary. It dials nothing, and `summarize.rs`
# proves the gist endpoint is on this host before a character of an agent's text goes out.
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# ProtectSystem/ProtectHome are deliberately NOT set to their strict values: the hub writes its
# registry, its ledger, its audit log, the ring and the answers drop under $HOME, and enumerating
# those in ReadWritePaths would break the moment one of them moves.
ProtectSystem=yes

[Install]
WantedBy=default.target
